# 复制为 .env 后填写真实值
# 格式：postgresql://<用户>:<密码>@<主机>:<端口>/<库名>?schema=public
DATABASE_URL="postgresql://worklog:CHANGE_ME@127.0.0.1:5432/worklog?schema=public"

NODE_ENV=development
PORT=3000
TZ=Asia/Shanghai

# ── AI 助手（M6 阶段启用，详见需求文档 §8.4）─────────────────
ASSISTANT_ENABLED=true
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-CHANGE_ME
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_MS=60000
LLM_MAX_TOOL_ROUNDS=6
ASSISTANT_DAILY_TOKEN_BUDGET=500000
ASSISTANT_CONTEXT_MESSAGES=12
ASSISTANT_DEFAULT_AUTO_EXECUTE=always_confirm
